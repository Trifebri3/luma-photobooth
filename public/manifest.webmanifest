{
  "name": "Luma Photobooth - by YOTA INOVASI NUSANTARA",
  "short_name": "Luma Booth",
  "description": "Platform Photobooth Digital & Self-Service Kiosk Multi-Event by YOTA INOVASI NUSANTARA",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "fullscreen",
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
